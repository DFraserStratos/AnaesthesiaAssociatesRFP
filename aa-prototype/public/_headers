# Cloudflare Pages headers for the installable PWA target — the equivalent of
# the `headers` block in vercel.json (which Cloudflare does not read).

# The service worker must always be revalidated, or a phone sits on an old
# build with no outward sign. This is the single most important rule here.
/sw.js
  Cache-Control: public, max-age=0, must-revalidate

/manifest.webmanifest
  Content-Type: application/manifest+json; charset=utf-8
  Cache-Control: public, max-age=0, must-revalidate

# Content-hashed / versioned, safe to cache hard for a year.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/assets/*
  Cache-Control: public, max-age=31536000, immutable
