          "steps": [
            {
              "goto": "/admin/contracts/CT-STG-D1"
            },
            {
              "wait": "[data-shot=contract-detail]"
            },
            {
              "wait": 400
            }
          ],
          "highlight": [
            "[data-shot=contract-price]"
          ]
        },
        {
          "state": "contract-rate",
          "caption": "RVG at the Contract's rate: Aria's units at $26.50 a unit, the price fixed for the anaesthetist",
          "steps": [
            {
              "goto": "/admin/contracts/CT-ARIA-HOURLY"
            },
            {
              "wait": "[data-shot=contract-detail]"
            },
            {
              "wait": 400
            }
          ],
          "highlight": [
            "[data-shot=contract-price]"
          ]
        },
        {
          "state": "discount",
          "caption": "RVG less the Contract's discount: Forte Health at standard RVG less 10%",
          "steps": [
            {
              "goto": "/admin/contracts/CT-FORTE-DISC"
            },
            {
              "wait": "[data-shot=contract-detail]"
            },
            {
              "wait": 400
            }
          ],
          "highlight": [
            "[data-shot=contract-price]"
          ]
        },
        {
          "state": "fixed-price",
          "caption": "Fixed price: the price of the range in force on the procedure date, no setting to change it",
          "steps": [
            {
              "goto": "/admin/contracts/CT-DOYLE-BAR"
            },
            {
              "wait": "[data-shot=contract-detail]"
            },
            {
              "wait": 400
            }
          ],
          "highlight": [
            "[data-shot=contract-price-ranges]"
          ]
        },
        {
          "state": "open-price",
          "caption": "Open price: no figure on the Contract, the price typed on the Procedure",
          "steps": [
            {
              "click": "[data-shot=contract-catalogue] tr[data-system=openPriceFallback]:has-text(\"AA-FIX\")"
