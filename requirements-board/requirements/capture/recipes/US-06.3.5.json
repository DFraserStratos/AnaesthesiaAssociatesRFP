          "steps": [
            {
              "wait": "[data-shot=booking-prepayment]"
            }
          ],
          "highlight": [
            "[data-shot=booking-prepayment]"
          ]
        },
        {
          "state": "after",
          "caption": "Before the invoice is generated, a Contract no longer prepaid clears it",
          "steps": [
            {
              "click": "[data-shot=contract-rail-step-2] >> nth=0"
            },
            {
              "click": "[data-rail-option=standard] >> nth=0"
            },
            {
              "click": "[data-shot=contract-combo] >> nth=0"
            },
            {
              "click": "[data-contract-id=CT-NO-CONTRACT] >> nth=0"
            },
            {
              "wait": 600
            }
          ],
          "highlight": [
            "[data-shot=capture-billing] >> nth=0",
            "[data-shot=prepayment-recheck]"
          ]
        }
      ]
    },
    {
      "name": "recheck-moved",
      "app": "admin",
      "caption": "A move changes nothing: the sent prepayment and her Contract stay as they were",
      "start": "/admin/day/2026-11-27/bookings/BK0034",
      "setup": [
        {
          "goto": "/admin/finances/invoices?view=approval"
        },
        {
          "wait": "[data-shot=awaiting-approval-row][data-booking-id=BK0034]"
        },
        {
          "click": "[data-shot=awaiting-approval-row][data-booking-id=BK0034] [data-shot=approve-and-send]"
        },
        {
          "wait": "[data-shot=prepayment-letter-picker]"
        },
        {
          "click": "[data-shot=prepayment-letter-send]"
        },
        {
          "wait": 800
        }
      ],
      "states": [
        {
          "state": "moved",
          "steps": [
            {
              "goto": "/web/lists/L-34821-2026-11-27-AM/bookings/BK0034"
            },
            {
              "scroll": "[data-shot=\"move-booking-action\"]"
            },
            {
              "click": "[data-shot=\"move-booking-action\"] button"
            },
            {
              "wait": "[data-shot=\"move-booking-receivers\"]"
            },
            {
              "click": "[data-shot=\"move-booking-receiver\"] >> nth=0"
            },
            {
              "wait": "[data-shot=\"move-booking-confirm\"]"
            },
            {
              "wait": 400
            },
            {
              "click": "[data-shot=\"move-booking-submit\"] button"
            },
            {
              "wait": "[data-shot=\"move-booking-done\"]"
            },
            {
              "goto": "/admin/day/2026-11-27/bookings/BK0034"
            },
            {
              "wait": "[data-shot=booking-prepayment]"
