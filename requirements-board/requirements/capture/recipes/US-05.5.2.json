    {
      "name": "acc-preop",
      "app": "admin",
      "caption": "Like every event, the ACC pre-op assessment is billed in the next run: here CS250 is its own line on the Procedure's invoice",
      "setup": [
        {
          "goto": "/web/lists"
        },
        {
          "trigger": "stage-post-op"
        },
        {
          "wait": 800
        }
      ],
      "start": "/admin/lists/to-authorise",
      "states": [
        {
          "state": "on-invoice",
          "steps": [
            {
              "goto": "/web/lists?q=Bennett"
            },
            {
              "wait": "[data-shot=web-lookback-search] tr[data-booking-id]"
            },
            {
              "click": "[data-shot=web-lookback-search] tr[data-booking-id]:has-text(\"18 Nov\") >> nth=0"
            },
            {
              "wait": "[data-shot=procedure-events]"
            },
            {
              "click": "[data-shot=add-pre-post-op-event] >> nth=0"
            },
            {
              "wait": "[data-shot=add-event-sheet]"
            },
            {
              "wait": 400
            },
            {
              "click": "[data-shot=add-event-sheet] button:text-is(\"Pre-op\")"
            },
            {
              "click": "[data-shot=add-event-sheet] [data-shot=event-type-row][data-type=accPreOpAssessment]"
            },
            {
              "click": "[data-shot=add-event-sheet] [data-shot=acc-preop-preset][data-code=CS250]"
            },
            {
              "click": "[data-shot=add-event-sheet] [data-shot=add-event-save]"
            },
            {
              "wait": 600
            },
            {
              "goto": "/admin/finances/payments"
            },
            {
              "wait": "[data-shot=admin-events-queue]"
            },
            {
              "click": "[data-shot=admin-events-queue] tr[data-kind=preOp]:has-text(\"Coral Bennett\")"
            },
            {
              "wait": "[data-shot=event-review-sheet]"
            },
            {
              "click": "[data-shot=event-review-sheet] [data-shot=event-review-approve]"
            },
            {
              "wait": 500
            },
            {
              "press": "Escape"
            },
            {
              "wait": 300
            },
            {
              "goto": "/admin/lists/to-authorise"
            },
            {
              "click": "role=button[name=/^Review .*Souter.*Wed 18 Nov$/]"
            },
            {
              "wait": "role=button[name=\"Authorise for billing\"]"
            },
            {
              "click": "role=button[name=\"Authorise for billing\"] >> nth=0"
            },
            {
              "wait": 300
            },
            {
              "click": "role=button[name=\"Authorise for billing\"] >> nth=-1"
            },
            {
              "wait": "text=\"List authorised · locked for billing\""
            },
            {
              "goto": "/admin/finances/invoices?show=all&q=Bennett"
            },
            {
              "wait": "[data-shot=invoice-list-event-lines]"
            },
            {
              "goto": "/admin/finances/invoices?show=all&q=Bennett"
            },
            {
              "click": "[data-shot=invoice-list-event-lines] >> nth=0"
            },
            {
              "wait": "tr[data-shot=invoice-event-lines]"
            },
            {
              "scroll": "tr[data-shot=invoice-event-lines] >> nth=0"
            }
          ],
          "highlight": [
            "tr[data-shot=invoice-event-lines]"
          ]
        }
