            },
            {
              "wait": 300
            }
          ],
          "highlight": [
            "[data-shot=credit-form]"
          ]
        },
        {
          "state": "event",
          "caption": "Recorded as an event on the Procedure, awaiting the office's review",
          "steps": [
            {
              "click": "[data-shot=anaesthetist-credit-note-button] >> nth=0"
            },
            {
              "wait": "[data-shot=credit-form]"
            },
            {
              "wait": 400
            },
            {
              "click": "[data-shot=credit-form] [data-shot=credit-reason-chip]:has-text(\"Less work than expected\")"
            },
            {
              "click": "[data-shot=credit-submit]"
            },
            {
              "wait": "[data-shot=procedure-credit-event]"
            },
            {
              "wait": 500
            },
            {
              "scroll": "[data-shot=procedure-credit-event] >> nth=0"
            }
          ],
          "highlight": [
            "[data-shot=procedure-credit-event]"
          ]
        }
      ]
    },
