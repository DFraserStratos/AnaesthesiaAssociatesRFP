  "shots": [
    {
      "name": "approve-and-send",
      "app": "admin",
      "caption": "One prepayment invoice per payer, generated when an admin approves it (a step AA can switch off), its payable to the AA Holding account",
      "start": "/admin/invoices?view=approval",
      "states": [
        {
          "state": "awaiting-approval",
          "caption": "Prepayment approval is on: Riley's $1,200.00 awaits approval on the Invoices strip",
          "steps": [
            {
              "wait": "[data-shot=invoices-awaiting-approval]"
            }
          ],
          "highlight": [
            "[data-shot=invoices-awaiting-approval]",
            "[data-shot=prepayment-approval-switch]"
          ]
        },
        {
          "state": "sent",
          "caption": "Approve and send: the invoice goes out at $1,200.00 plus GST",
          "steps": [
            {
              "wait": "[data-shot=awaiting-approval-row][data-booking-id=BK0034]"
            },
            {
              "click": "[data-shot=awaiting-approval-row][data-booking-id=BK0034] [data-shot=approve-and-send]"
            },
            {
              "wait": "[data-shot=prepayment-letter-picker]"
            },
            {
              "click": "[data-shot=prepayment-letter-send]"
            },
            {
              "wait": "[data-shot=approve-and-send-result]"
            }
          ],
          "highlight": [
            "[data-shot=approve-and-send-result]"
          ]
        },
        {
          "state": "approval-off",
          "caption": "Prepayment approval switched off: a Booking added afterwards is invoiced at once, with nothing waiting on the strip",
          "steps": [
            {
              "click": "[data-shot=prepayment-approval-switch]"
            },
            {
              "click": "[data-shot=prepayment-approval-off-confirm]"
            },
            {
              "wait": 400
            },
            {
              "goto": "/admin/day/2026-11-24"
            },
            {
              "trigger": "add-prepaid-booking",
              "choice": "one-payer"
            },
            {
              "goto": "/admin/invoices?view=approval"
            },
            {
              "wait": "[data-shot=prepayment-approval-switch]"
            }
          ],
          "highlight": [
            "[data-shot=prepayment-approval-switch]",
            "[data-shot=invoices-awaiting-approval]"
          ]
        },
        {
          "state": "two-payers",
          "caption": "Two payers on one Booking: one invoice per payer, and the other payer still awaits approval",
          "steps": [
            {
              "goto": "/admin/day/2026-11-24"
            },
            {
              "trigger": "add-prepaid-booking",
              "choice": "two-payers"
            },
            {
              "goto": "/admin/invoices?view=approval"
            },
            {
              "wait": "[data-shot=awaiting-approval-row]:has-text(\"Fiona Gray\")"
            },
            {
              "click": "[data-shot=awaiting-approval-row]:has-text(\"Fiona Gray\") [data-shot=approve-and-send] >> nth=0"
            },
            {
              "wait": "[data-shot=prepayment-letter-picker]"
            },
            {
              "click": "[data-shot=prepayment-letter-send]"
            },
            {
              "wait": "[data-shot=approve-and-send-result]"
            }
          ],
          "highlight": [
            "[data-shot=invoices-awaiting-approval]",
            "[data-shot=approve-and-send-result]"
          ]
        }
      ]
    },
