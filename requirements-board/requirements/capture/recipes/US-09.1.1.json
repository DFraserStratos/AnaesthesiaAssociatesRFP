      "setup": [
        {
          "goto": "/admin/billing"
        },
        {
          "trigger": "xero-outage-start"
        },
        {
          "wait": 400
        },
        {
          "goto": "/admin/review/L-25490-2026-11-23-AM"
        },
        {
          "click": "role=button[name=\"Authorise for billing\"] >> nth=0"
        },
        {
          "wait": 600
        },
        {
          "click": "role=button[name=\"Authorise for billing\"] >> nth=-1"
        },
        {
          "wait": 1500
        },
        {
          "goto": "/admin/billing"
