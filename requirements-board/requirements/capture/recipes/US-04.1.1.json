      "states": [
        {
          "state": "settings",
          "steps": [
            {
              "fill": "[data-shot=contract-search] input",
              "value": "Unisports"
            },
            {
              "wait": 300
            },
            {
              "click": "[data-shot=contract-catalogue] tr[data-contract]:has-text(\"Unisports\") >> button:text-is(\"Edit\")"
            },
            {
              "wait": 500
            }
          ],
          "highlight": [
            "[data-shot=contract-settings]",
            "[data-shot=contract-links] div:has(> div:text-is(\"Bills\"))"
          ]
        },
        {
          "state": "prepaid-refusal",
          "caption": "A prepaid Contract priced from RVG units is refused with the store's sentence",
          "steps": [
            {
              "click": "role=button[name=\"New contract\"]"
            },
            {
              "wait": 500
            },
            {
              "fill": "[data-shot=contract-detail] >> role=textbox[name=\"Name\"]",
              "value": "Cataract prepay"
            },
            {
              "select": "[data-shot=contract-links] select",
              "value": "PY-CES"
            },
            {
              "click": "[data-shot=contract-settings] >> role=button[name=\"Yes\"] >> nth=0"
            },
            {
              "click": "role=button[name=\"Create contract\"]"
            },
            {
              "wait": 400
            },
            {
              "scroll": "[data-shot=contract-detail] [role=alert]"
            }
          ],
          "highlight": [
            "[data-shot=contract-settings]",
            "[data-shot=contract-detail] [role=alert]"
          ]
        }
      ]
    }
