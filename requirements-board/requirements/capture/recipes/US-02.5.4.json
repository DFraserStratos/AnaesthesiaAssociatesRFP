{
  "id": "US-02.5.4",
  "status": "partial",
  "absentReason": "Automated changes are Future Work. In the first release every hospital change waits for the office, who may apply it until the List is authorised.",
  "shots": [
    {
      "name": "change-cutoff",
      "app": "admin",
      "caption": "A hospital change can be applied until its List is authorised",
      "start": "/admin/matching",
      "setup": [
        {
          "goto": "/admin/integrations"
        },
        {
          "trigger": "fire-hospital-message",
          "choice": "MSG-STG-1014"
        },
        {
          "wait": 800
        }
      ],
      "states": [
        {
          "state": "rows",
          "caption": "A change to a submitted List beside a change for an authorised List, both waiting for the office",
          "steps": [
            {
              "click": "[data-shot=matching-import-open]"
            },
            {
              "wait": "[data-shot=matching-import]"
            },
            {
              "click": "[data-sample-id=SAMPLE_SX]"
            },
            {
              "click": "[data-shot=matching-import-confirm]"
            },
            {
              "wait": "[data-shot=matching-panel]"
            },
            {
              "wait": 400
            },
            {
              "press": "Escape"
            },
            {
              "wait": 400
            }
          ],
          "highlight": [
            "[data-shot^='matching-row-']:has-text('Alan Prentice')",
            "[data-shot^='matching-row-']:has-text('Hemi Walker')"
          ]
        },
        {
          "state": "submitted",
          "caption": "A change to a submitted List: the office can still apply it",
          "steps": [
            {
              "click": "[data-shot=matching-import-open]"
            },
            {
              "wait": "[data-shot=matching-import]"
            },
            {
              "click": "[data-sample-id=SAMPLE_SX]"
            },
            {
              "click": "[data-shot=matching-import-confirm]"
            },
            {
              "wait": "[data-shot=matching-panel]"
            },
            {
              "wait": 400
            },
            {
              "press": "Escape"
            },
            {
              "wait": 400
            },
            {
              "click": "[data-shot^='matching-row-']:has-text('Alan Prentice')"
            },
            {
              "wait": "[data-shot=matching-panel]"
            },
            {
              "wait": 400
            }
          ],
          "highlight": [
            "[data-shot=matching-diff]",
            "[data-shot=matching-apply]"
          ]
        },
        {
          "state": "authorised",
          "caption": "A change for an authorised List: flagged List authorised, and apply is disabled because the List is locked",
          "steps": [
            {
              "click": "[data-shot=matching-import-open]"
            },
            {
              "wait": "[data-shot=matching-import]"
            },
            {
              "click": "[data-sample-id=SAMPLE_SX]"
            },
            {
              "click": "[data-shot=matching-import-confirm]"
            },
            {
              "wait": "[data-shot=matching-panel]"
            },
            {
              "wait": 400
            },
            {
              "press": "Escape"
            },
            {
              "wait": 400
            },
            {
              "click": "[data-shot^='matching-row-']:has-text('Hemi Walker')"
            },
            {
              "wait": "[data-shot=matching-panel]"
            },
            {
              "wait": 400
            }
          ],
          "highlight": [
            "[data-shot=matching-panel]"
          ]
        }
      ]
    }
  ]
}
