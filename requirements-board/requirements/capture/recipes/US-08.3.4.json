        {
          "wait": 600
        },
        {
          "trigger": "payment-full"
        },
        {
          "wait": 600
        }
      ],
      "states": [
        {
          "steps": [
            {
              "click": "[data-shot=payment-cycle-close]"
            },
            {
              "wait": "[data-shot=payment-cycle-approve]"
            },
            {
              "click": "[data-shot=payment-cycle-approve]"
            },
            {
              "wait": "[data-shot=payment-cycle-send]"
            },
            {
              "click": "[data-shot=payment-cycle-send]"
            },
            {
              "wait": 2500
            },
            {
              "click": "[data-shot=billing-run-payables-in-xero]", "timeout": 45000
            },
            {
              "wait": "[data-shot=billing-payables-result]"
            },
            {
              "wait": 2200
            }
          ],
          "highlight": [
            "[data-shot=billing-pipeline-L-34821-2026-11-23-AM]"
          ]
        }
      ]
    },
    {
      "name": "ledger-balance",
