        {
          "goto": "/web/lists"
        },
        {
          "trigger": "stage-post-op"
        },
        {
          "wait": 800
        }
      ],
      "start": "/admin/day/2026-07-15",
      "states": [
        {
          "state": "button",
          "caption": "The two add buttons under the Procedure's events on the Admin Booking detail",
          "steps": [
            {
              "click": "button[data-slot-id=\"S-34821-2026-07-15-PM\"]"
            },
            {
              "wait": "[data-testid=admin-list-drawer]"
            },
            {
              "click": "[data-testid=admin-list-drawer] >> role=button[name=/^Open$/]"
