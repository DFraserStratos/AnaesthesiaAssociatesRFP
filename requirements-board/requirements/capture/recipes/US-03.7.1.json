    {
      "name": "contract-event-fees",
      "app": "admin",
      "caption": "Event fees on a Contract: St George's ACC prices a pain consult at a fixed $120.00, STGACC-PAIN, in place of its time",
      "start": "/admin/masters?view=contracts",
      "states": [
        {
          "steps": [
