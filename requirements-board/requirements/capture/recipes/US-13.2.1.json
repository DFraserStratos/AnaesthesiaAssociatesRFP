{
  "id": "US-13.2.1",
  "status": "captured",
  "absentReason": "",
  "shots": [
    {
      "name": "whole-ledger",
      "app": "admin",
      "caption": "The Ledger tab: whether the books are square, with what is owed to AA, owed to the anaesthetists, held and disbursed",
      "start": "/admin/finances/ledger",
      "states": [
        {
          "steps": [
            {
              "wait": "[data-shot=ledger-balance][data-in-balance=true]"
            }
          ],
          "highlight": [
            "[data-shot=ledger-balance]",
            "[data-shot=ledger-tiles]"
          ]
        }
      ]
    },
    {
      "name": "anaesthetist-scope",
      "app": "admin",
      "caption": "Dr Souter's account under Ledger: what AA owes her and what she owes AA",
      "start": "/admin/finances/ledger/anaesthetists/34821",
      "states": [
        {
          "steps": [
            {
              "wait": "[data-shot=ledger-aa-owes]"
            },
            {
              "wait": 300
            }
          ],
          "highlight": [
            "[data-shot=ledger-account-status]",
            "[data-shot=ledger-aa-owes]",
            "[data-shot=ledger-owes-aa]"
          ]
        }
      ]
    },
    {
      "name": "imbalance",
      "app": "admin",
      "caption": "A $120.00 receipt that matches no invoice is held, and the ledger is out of balance by $120.00",
      "start": "/admin/finances/ledger",
      "setup": [
        {
          "goto": "/admin/finances/ledger"
        },
        {
          "trigger": "inject-unmatched-receipt",
          "choice": "souter"
        },
        {
          "wait": 600
        }
      ],
      "states": [
        {
          "steps": [
            {
              "wait": "[data-shot=ledger-balance][data-in-balance=false]"
            }
          ],
          "highlight": [
            "[data-shot=ledger-balance]",
            "[data-shot=ledger-unmatched]"
          ]
        }
      ]
    },
    {
      "name": "out-of-balance-list",
      "app": "admin",
      "caption": "The Anaesthetists list narrowed to those out of balance: Dr Souter is on it while the receipt naming her is held",
      "start": "/admin/finances/ledger?balance=out",
      "setup": [
        {
          "goto": "/admin/finances/ledger"
        },
        {
          "trigger": "inject-unmatched-receipt",
          "choice": "souter"
        },
        {
          "wait": 600
        }
      ],
      "states": [
        {
          "steps": [
            {
              "wait": "[data-shot=ledger-anaesthetists] tr[data-anaesthetist-id=\"34821\"]"
            },
            {
              "wait": 300
            }
          ],
          "highlight": [
            "[data-shot=ledger-anaesthetists]"
          ]
        }
      ]
    }
  ]
}
