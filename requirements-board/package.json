    "export:csv": "node scripts/export-csv.ts",
    "capture": "node scripts/capture.ts"
  },
  "dependencies": {
    "@fontsource/hanken-grotesk": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
